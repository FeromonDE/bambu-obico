BAMBU_HOST=192.168.2.X
BAMBU_SERIAL=YOUR_PRINTER_SERIAL
BAMBU_ACCESS_CODE=YOUR_LAN_ACCESS_CODE
BAMBU_MQTT_PORT=8883
BAMBU_TLS_INSECURE=true
BAMBU_DUMP_JSON=false

# Local-only directory containing:
#   slicer_key.pem
#   slicer_cert.pem
#   slicer_crl.pem
# Never commit these files.
BAMBU_SIGNING_DIR=/home/pi/.config/bambu-obico/signing

OBICO_SERVER=https://obico.example.com
OBICO_AUTH_TOKEN=

# Existing Eufy/go2rtc webcam
WEBCAM_SNAPSHOT_URL=http://192.168.2.129:1984/api/frame.jpeg?src=eufy_h264
WEBCAM_H264_HTTP_URL=http://192.168.2.129:1984/api/stream.mp4?src=eufy_h264
